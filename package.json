{
  "name": "expenso",
  "version": "2.0.0",
  "private": true,
  "description": "Expenso: a personal finance tracker with budgets, recurring payments and reports (MERN).",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "demo": "node scripts/demo.js",
    "client": "npm run dev --prefix client",
    "dev:all": "concurrently -n api,web -c cyan,magenta \"npm run demo\" \"npm run client\"",
    "build": "npm install --prefix client && npm run build --prefix client",
    "test": "node --test --test-concurrency=1 tests/"
  },
  "engines": {
    "node": ">=18"
  },
  "author": "Kavya Immanni",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.2",
    "morgan": "^1.12.1",
    "nodemailer": "^10.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "concurrently": "^9.2.5",
    "expect": "^30.5.2",
    "mongodb-memory-server": "^11.3.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.1"
  }
}
