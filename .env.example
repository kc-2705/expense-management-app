# Copy this file to .env and fill in your own values. Never commit .env.

# MongoDB connection string (for example a free MongoDB Atlas cluster).
MONGO_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/expenso

# Long random string used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me

PORT=8080
# Front-end address(es) allowed to call the API, comma separated.
CLIENT_URL=http://localhost:5173

# Optional: email server for password reset codes. Without it, the code is
# shown in the app during local development.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=Expenso <no-reply@example.com>

# Local AI assistant (optional). Install Ollama from https://ollama.com, then run: ollama pull llama3.2:3b
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2:3b
